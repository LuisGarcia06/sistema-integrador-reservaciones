{
  "name": "sistema-integrador-reservaciones",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.js",
  "scripts": {
    "start": "node backend/server.js",
    "test": "jest",
    "desktop": "electron .",
    "pack:win": "electron-builder --win --x64 --dir",
    "dist:win": "electron-builder --win --x64"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/local-auth": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^105.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jest": "^30.5.2",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testMatch": [
      "**/*.test.js"
    ]
  },
  "build": {
    "appId": "com.communitytours.reservaciones",
    "productName": "Sistema Integrador de Reservaciones",
    "artifactName": "Sistema-Integrador-Reservaciones-${version}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/**/*",
      "package.json",
      "!**/.env",
      "!**/.env.*",
      "!database/**/*",
      "!docs/**/*",
      "!referencias/**/*",
      "!scripts/**/*",
      "!.git/**/*",
      "!dist/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "backend/**/*",
      "frontend/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
